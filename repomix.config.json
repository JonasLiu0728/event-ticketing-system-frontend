{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml"
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      "dist/**",
      ".env*",
      "repomix-output.xml",
      "src/assets/**",
      "public/**",
      "*.lock",
      "package-lock.json",
      "test-results/**",
      "src/mock/**",
      "src/App.css",
      "e2e/**",
      "指令集/**",
      "系統markdown.txt",
      "要修正的問題.txt",
      "seed_events.sh"
    ]
  }
}